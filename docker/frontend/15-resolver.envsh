#!/bin/sh
# Sourced by the nginx image's entrypoint before the templates are rendered (*.envsh files are
# sourced, so the variable reaches envsubst).
#
# nginx resolves BACKEND_UPSTREAM per request (see nginx.conf.template), which needs a DNS
# server. Use the container's own: Docker's embedded DNS (127.0.0.11) on a user-defined network
# such as Compose's, otherwise the host's resolver. NGINX_RESOLVER can be set to override it.

if [ -z "${NGINX_RESOLVER:-}" ]; then
  NGINX_RESOLVER=$(awk '$1 == "nameserver" { print $2; exit }' /etc/resolv.conf 2>/dev/null)
  # An IPv6 nameserver must be written in brackets.
  case "$NGINX_RESOLVER" in
    *:*) NGINX_RESOLVER="[$NGINX_RESOLVER]" ;;
  esac
  NGINX_RESOLVER="${NGINX_RESOLVER:-127.0.0.11}"
fi
export NGINX_RESOLVER
